//-----------------------------------------------------------------------------
//	SERVER_RTBR.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"raisingthebarredux"
$Macro PDBNAME		"server.pdb"

$Include "$SRCDIR\game\server\server_episodic_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;.\rtbr;$SRCDIR\game\shared\rtbr"
		$PreprocessorDefinitions		"$BASE;RTBR_DLL;RTBR_RELEASE;"
	}
}

$Project "Server (RTBR Release)"
{
	$Folder "Source Files"
	{
		-$File	"$SRCDIR\game\shared\weapon_parse_default.cpp"

		$Folder "RTBR"
		{
			$Folder "NPCs"
			{
				$Folder "Flora"
				{
					$File "rtbr\npc_xenshroom.cpp"
					$File "rtbr\npc_xencoil.cpp"
					$File "rtbr\npc_xenlight.cpp"
					$File "rtbr\npc_xensack.cpp"
				}
				
				$File	"$SRCDIR\game\shared\rtbr\npc_cremator_shared.h"
				$File	"rtbr\npc_combineguard.cpp"
				$File	"rtbr\npc_protozoan.cpp"
				$File	"rtbr\npc_protozoan.h"
				$File	"rtbr\npc_cremator.cpp"
				$File	"rtbr\npc_cremator.h"
				$File	"rtbr\npc_sandbarnacle.cpp"
				$File	"rtbr\npc_houndeye.cpp"
